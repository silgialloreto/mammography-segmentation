%% morphological
close all;

I=imread(pximds.Images{1});
GT=imread(pximds.PixelLabelData{1});

B=strel('disk',7);
GT1=imopen(GT,B);
figure(); 
imshow(GT1);

GT2=imclose(GT,B);
figure(); 
imshow(GT2);

GT3=bwperim(GT);
figure(); 
imshow(GT3);

GT4=bwmorph(GT,'skel','inf');
figure(); 
imshow(GT4);

GT5=imtophat(GT,B);
figure(); 
imshow(GT5);

GT6=bwareafilt(GT5,1);
figure(); 
imshow(GT6);

%% features eextraction

R=regionprops(logical(GT),'All');
close all;
imshow(GT); 
hold on; 
drawrectangle('Position',R.BoundingBox);
Area_BB=R.BoundingBox(3)*R.BoundingBox(4);
Area_GT=R.Area;

%Extent = Area_GT/Area_BB

hold on; 
drawpolygon('Position',R.ConvexHull);
Area_CH=R.ConvexArea;
%Solidity = Area_GT/Area_CH;

% feature texture
Id=im2double(I);
mean_I=mean(Id(GT==1));
std_I=std(Id(GT==1));
median_I=median(Id(GT==1));
mode_I=mode(Id(GT==1));

% ribbon extraction
B=strel('disk',7);
GT_int=imerode(GT,B);
GT_ext=imdilate(GT,B);
ribbon=GT_ext-GT_int;

figure(); imshow(ribbon);
figure(); imshow(Id.*ribbon);

Id_ribbon=Id.*ribbon;
mean_rib=mean(Id_ribbon);
std_rib=std(Id_ribbon);
median_rib=median(Id_ribbon);
mode_rib=mode(Id_ribbon);

